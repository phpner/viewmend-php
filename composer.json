{
    "name": "viewmend/sdk",
    "description": "Official framework-agnostic PHP SDK for ViewMend APIs, including Site Tracker events and Cron for plugins.",
    "homepage": "https://viewmend.com/",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "api-client",
        "change-monitoring",
        "deployment-monitoring",
        "cron",
        "php-sdk",
        "site-tracker",
        "scheduled-tasks",
        "viewmend",
        "website-monitoring"
    ],
    "support": {
        "email": "support@viewmend.com",
        "issues": "https://github.com/phpner/viewmend-php/issues",
        "source": "https://github.com/phpner/viewmend-php"
    },
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "ViewMend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ViewMend\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --debug --memory-limit=512M",
        "cs:check": "phpcs",
        "quality": [
            "@composer validate --no-check-publish",
            "@cs:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": false,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
